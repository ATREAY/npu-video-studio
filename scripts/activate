# shellcheck shell=bash
# Usage:  source scripts/activate
#
# Deliberately does NOT call `conda activate` / `source activate` — that needs
# conda's shell hook loaded in the *current* shell (`conda init` only wires up
# *future* shells, so it throws "Run 'conda init' before 'conda activate'" here
# even right after running conda init). All we actually need is the venv's own
# bin/ on PATH, so just do that directly — works in any shell, no conda hook needed.
_PROJ="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
_VENV="$_PROJ/.venv"

case ":$PATH:" in
    *":$_VENV/bin:"*) ;;                    # already on PATH, don't duplicate
    *) export PATH="$_VENV/bin:$PATH" ;;
esac
export VIRTUAL_ENV="$_VENV"

# --- isolation: never see or write the user's ~/.local thesis packages ---
export PYTHONNOUSERSITE=1     # hide ~/.local/lib/pythonX/site-packages from this env
export PIP_USER=0             # pip must install into the venv, never --user
export QAIHM_CI=1              # qai_hub_models: auto-accept model-repo git clone (no prompt)
export QAI_HUB_MODELS_CACHE="$_PROJ/.qai_hub_models"

echo "env: $(python --version)  |  no-user-site: $PYTHONNOUSERSITE  |  project: $_PROJ"
